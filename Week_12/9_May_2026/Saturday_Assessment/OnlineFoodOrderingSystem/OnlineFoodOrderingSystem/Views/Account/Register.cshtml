@model OnlineFoodOrderingSystem.ViewModels.RegisterViewModel

<div class="auth-card">

    <h1 class="text-center mb-4">
        Register
    </h1>

    <form asp-action="Register"
          method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">

            <label>Email</label>

            <input asp-for="Email"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label>Password</label>

            <input asp-for="Password"
                   type="password"
                   class="form-control" />

        </div>

        <button type="submit"
                class="btn btn-primary w-100">

            Register

        </button>

    </form>

</div>