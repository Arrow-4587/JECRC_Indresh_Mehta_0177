@model OnlineFoodOrderingSystem.ViewModels.LoginViewModel

<div class="auth-card">

    <h1 class="text-center mb-4">
        Login
    </h1>

    <form asp-action="Login"
          method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">

            <label>Email</label>

            <input asp-for="Email"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label>Password</label>

            <input asp-for="Password"
                   type="password"
                   class="form-control" />

        </div>

        <button type="submit"
                class="btn btn-dark w-100">

            Login

        </button>

    </form>

    <div class="text-center mt-3">

        <a asp-controller="Account"
           asp-action="ForgotPassword">

            Forgot Password?

        </a>

    </div>

    <div class="text-center mt-2">

        <a asp-controller="Account"
           asp-action="Register">

            Create New Account

        </a>

    </div>

</div>