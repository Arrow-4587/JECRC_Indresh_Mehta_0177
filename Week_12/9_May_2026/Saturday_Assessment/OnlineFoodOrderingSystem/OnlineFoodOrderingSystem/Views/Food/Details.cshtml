@model OnlineFoodOrderingSystem.Models.FoodItem

<div class="row">

    <div class="col-md-6 mb-4">

        <img src="@Model.ImageUrl"
             class="food-details-image" />

    </div>

    <div class="col-md-6">

        <div class="food-details-box">

            <h1>@Model.Name</h1>

            <p class="food-description mt-3">
                @Model.Description
            </p>

            <h3 class="food-price">
                ₹@Model.Price
            </h3>

            <p class="mt-3">

                <strong>Category:</strong>

                @Model.Category?.CategoryName

            </p>

            <a asp-controller="Cart"
               asp-action="AddToCart"
               asp-route-id="@Model.FoodId"
               class="btn btn-primary mt-3">

                Add To Cart

            </a>

        </div>

    </div>

</div>