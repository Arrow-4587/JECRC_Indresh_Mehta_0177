@model OnlineFoodOrderingSystem.Models.Category

<h1 class="page-title mb-4">
    Create Category
</h1>

<form asp-action="CreateCategory"
      method="post">

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">

        <label class="form-label">

            Category Name

        </label>

        <input asp-for="CategoryName"
               class="form-control" />

        <span asp-validation-for="CategoryName"
              class="text-danger">
        </span>

    </div>

    <button type="submit"
            class="btn btn-success">

        Save Category

    </button>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}